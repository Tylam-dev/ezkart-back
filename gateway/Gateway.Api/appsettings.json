{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "ApiScope",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      }
    }
  },
  "Clusters": {
    "auth-cluster": {
      "Destinations": {
        "auth-destination": {
          "Address": "http://localhost:5001/"
        }
      }
    }
  },
  "AllowedHosts": "*"
}
