{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/login" }
      },
      "auth-refresh": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/refresh" }
      },
      "auth-me": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/auth/me" }
      },
      "auth-protected": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "AuthApi",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "inventario": {
        "ClusterId": "inventario-cluster",
        "AuthorizationPolicy": "AuthApi",
        "Match": { "Path": "/products/{**catch-all}" }
      },
      "carrito": {
        "ClusterId": "compras-cluster",
        "AuthorizationPolicy": "AuthApi",
        "Match": { "Path": "/cart/{**catch-all}" }
      },
      "compras": {
        "ClusterId": "compras-cluster",
        "AuthorizationPolicy": "AuthApi",
        "Match": { "Path": "/orders/{**catch-all}" }
      }
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "ClockSkewSegundos": 30
  }
}
